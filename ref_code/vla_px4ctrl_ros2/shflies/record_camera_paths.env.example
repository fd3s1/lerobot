# Copy this file to record_camera_paths.env and edit the two paths after checking
# /dev/v4l/by-path on the NX. Use by-path for two identical USB cameras because
# it stays tied to the physical USB port.
#
# Example commands:
#   ls -l /dev/v4l/by-path/
#   ffplay /dev/v4l/by-path/<candidate-video-index0>
#
# FRONT_CAMERA="/dev/v4l/by-path/<front-camera-video-index0>"
# DOWN_CAMERA="/dev/v4l/by-path/<down-camera-video-index0>"
#
# Optional third top-view camera on another computer:
# 1. On the computer with the top camera:
#      bash shflies/start_top_camera_zmq.sh
# 2. On the NX, enable the ZMQ camera and set the top-camera computer IP:
#      TOP_CAMERA_ENABLE=true
#      TOP_CAMERA_TYPE=zmq
#      TOP_CAMERA_SERVER="10.1.1.xxx"
#      TOP_CAMERA_PORT=5555
#      TOP_CAMERA_NAME=top
#      TOP_CAMERA_WIDTH=640
#      TOP_CAMERA_HEIGHT=480
#      TOP_CAMERA_FPS=20
