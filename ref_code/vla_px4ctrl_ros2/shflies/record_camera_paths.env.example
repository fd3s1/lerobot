# Copy this file to record_camera_paths.env and edit the two paths after checking
# /dev/v4l/by-path on the NX. Use by-path for two identical USB cameras because
# it stays tied to the physical USB port.
#
# Example commands:
#   ls -l /dev/v4l/by-path/
#   ffplay /dev/v4l/by-path/<candidate-video-index0>
#
# FRONT_CAMERA="/dev/v4l/by-path/<front-camera-video-index0>"
# DOWN_CAMERA="/dev/v4l/by-path/<down-camera-video-index0>"
