FRONT_CAMERA="/dev/v4l/by-path/platform-3610000.usb-usb-0:2.3:1.0-video-index0"
DOWN_CAMERA="/dev/v4l/by-path/platform-3610000.usb-usb-0:2.1:1.0-video-index0"
CAMERA_FPS=30

# Optional third camera. Start shflies/start_top_camera_zmq.sh on the computer
# that has the top-view USB camera, then set TOP_CAMERA_ENABLE=true and
# TOP_CAMERA_SERVER to that computer's LAN IP before recording on the NX.
TOP_CAMERA_ENABLE=false
TOP_CAMERA_TYPE=zmq
TOP_CAMERA_SERVER=""
TOP_CAMERA_PORT=5555
TOP_CAMERA_NAME=top
TOP_CAMERA_DEVICE="/dev/v4l/by-path/pci-0000:80:14.0-usb-0:9.1:1.0-video-index0"
TOP_CAMERA_WIDTH=640
TOP_CAMERA_HEIGHT=480
TOP_CAMERA_FPS=30
