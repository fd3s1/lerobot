# Shared grasp and payload-motion parameters.
# Use ": ${VAR:=value}" so command-line environment overrides still win:
#   GRASP_STEP_SIZE=2.0 bash shflies/handheld_grasp_tune.sh

: "${PAYLOAD_LIFT_SPEED:=0.15}"
: "${PAYLOAD_TRANSFER_SPEED:=0.50}"
: "${POST_GRASP_SETTLE_S:=0.3}"
: "${POST_LIFT_SETTLE_S:=1.0}"

: "${GRASP_MODE:=continuous_center}"
: "${GRIPPER_CLOSED:=0.0}"
: "${GRIPPER_CLOSE_DURATION_S:=4.0}"
: "${GRIPPER_X_OFFSET_M:=0.0}"
: "${GRIPPER_Y_OFFSET_M:=0.0}"
: "${TARGET_OFFSET_X:=-0.02}"
: "${TARGET_OFFSET_Y:=0.0}"
: "${TARGET_OFFSET_Z:=0.0}"
: "${WAYPOINT_ARRIVAL_TOLERANCE_M:=0.08}"
: "${WAYPOINT_ARRIVAL_SETTLE_S:=0.4}"
: "${WAYPOINT_ARRIVAL_TIMEOUT_S:=15.0}"

: "${GRASP_STEP_SIZE:=3.0}"
: "${GRASP_STEP_SETTLE_S:=0.10}"
: "${GRASP_OPEN_TIMEOUT_S:=2.0}"
: "${GRASP_OPEN_TOLERANCE:=5.0}"
: "${GRASP_STEP_TIMEOUT_S:=0.80}"
: "${GRASP_GOAL_TOLERANCE:=3.0}"
: "${GRASP_CLOSE_MIN:=15.0}"

: "${GRASP_CONTACT_CURRENT_DELTA:=250}"
: "${GRASP_CONTACT_LOAD_DELTA:=800}"
: "${GRASP_POSITION_ERROR_THRESHOLD:=20.0}"
: "${GRASP_ANGLE_CONTACT_DELTA:=20.0}"
: "${GRASP_STALL_DELTA:=0.25}"
: "${GRASP_CONTACT_MIN_CLOSE_DELTA:=15.0}"
: "${GRASP_CONTACT_CONFIRM_STEPS:=2}"

: "${GRASP_BALANCE_LOAD_DIFF:=60}"
: "${GRASP_BALANCE_STEP:=1.5}"
: "${GRASP_MAX_BALANCE_STEPS:=8}"
: "${GRASP_ANGLE_BALANCE_DIFF:=5.0}"
